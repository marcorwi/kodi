<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.radiowebitalia" name="Radio Web Italia Repo" version="1.3.9" provider-name="MAF Media Srls">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Radio Web Italia Repo">
        <dir>
            <info compressed="false">https://marcorwi.github.io/kodi/addons.xml</info>
            <checksum>https://marcorwi.github.io/kodi/addons.xml.md5</checksum>
            <datadir zip="false">https://marcorwi.github.io/kodi/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Repository ufficiale Radio Web Italia - Only Italian Music</summary>
        <description>Scarica e aggiorna l'add-on ufficiale per ascoltare la radio su Kodi.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
